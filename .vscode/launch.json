{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: current file",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: documentation examples",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/examples/workflows.py",
            "args": [
                "--output",
                "examples/output"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: debug tests",
            "type": "debugpy",
            "request": "launch",
            "purpose": [
                "debug-test"
            ],
            "program": "${file}",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "env": {
                "PYTEST_ADDOPTS": "--no-cov -W ignore::pytest_cov.CovDisabledWarning"
            }
        }
    ]
}

{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}",
        "env": {
            "NO_COLOR": "1"
        }
    },
    "tasks": [
        {
            "label": "Install locked development environment",
            "type": "process",
            "command": "uv",
            "args": [
                "sync",
                "--locked",
                "--extra",
                "dev",
                "--extra",
                "docs",
                "--extra",
                "pdf"
            ],
            "windows": {
                "command": "${env:ComSpec}",
                "args": [
                    "/d",
                    "/c",
                    "make.bat",
                    "install_editable"
                ]
            },
            "problemMatcher": []
        },
        {
            "label": "Run tests",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "pytest"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            }
        },
        {
            "label": "Check types",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "pyright",
                "--pythonpath",
                "${command:python.interpreterPath}"
            ],
            "problemMatcher": {
                "owner": "pyright-task",
                "source": "Pyright",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^\\s*(.+):(\\d+):(\\d+) - (error|warning): (.+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Check lint",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "ruff",
                "check",
                ".",
                "--output-format=concise"
            ],
            "problemMatcher": {
                "owner": "ruff-task",
                "source": "Ruff",
                "fileLocation": [
                    "autoDetect",
                    "${workspaceFolder}"
                ],
                "pattern": {
                    "regexp": "^(.+):(\\d+):(\\d+): (\\S+) (.+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "code": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Check formatting",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "ruff",
                "format",
                "--check",
                "."
            ],
            "problemMatcher": []
        },
        {
            "label": "Generate documentation",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "sphinx.cmd.build",
                "-W",
                "--keep-going",
                "-b",
                "html",
                "docs",
                "docs/_build/html"
            ],
            "problemMatcher": []
        },
        {
            "label": "Build distributions",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "scripts/release.py",
                "build",
                "--allow-dirty"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Benchmark Markdown",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "scripts/benchmark_markdown.py",
                "--max-seconds",
                "3"
            ],
            "problemMatcher": []
        },
        {
            "label": "Check project",
            "dependsOn": [
                "Check lint",
                "Check formatting",
                "Check types",
                "Run tests",
                "Generate documentation"
            ],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
